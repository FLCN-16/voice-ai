# Cal.com API credentials and optional platform headers.
# Copy these values to the project-root .env file. Never commit real secrets.
CALCOM_API_KEY=cal_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CALCOM_API_BASE_URL=https://api.cal.com

# The slots endpoint currently requires this API version.
CALCOM_SLOTS_API_VERSION=2024-09-04
# The bookings endpoint currently supports the newer booking fields below.
CALCOM_BOOKINGS_API_VERSION=2026-02-25
CALCOM_TIMEOUT_SECONDS=20

# Default event used by availability checks so callers are not asked for the
# owner's email. Use either an event type ID, or a slug with username/team slug.
CALCOM_DEFAULT_EVENT_TYPE_ID=
CALCOM_DEFAULT_EVENT_TYPE_SLUG=
CALCOM_DEFAULT_USERNAME=
CALCOM_DEFAULT_TEAM_SLUG=
CALCOM_DEFAULT_ORGANIZATION_SLUG=
CALCOM_DEFAULT_TIME_ZONE=UTC
CALCOM_DEFAULT_DURATION_MINUTES=30

# Optional: only for Cal.com platform/OAuth integrations.
CALCOM_CLIENT_ID=
CALCOM_SECRET_KEY=
